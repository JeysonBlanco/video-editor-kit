# API keys
.env

# Vídeos crudos / outputs pesados (excluidos por defecto)
input/*
output/*
!input/.gitkeep
!output/.gitkeep

# Compositions: permitir los HTMLs y JS de cada proyecto, NO los renders ni node_modules
!output/compositions/
output/compositions/*
!output/compositions/.gitkeep
!output/compositions/*/
output/compositions/*/*
!output/compositions/*/*.html
!output/compositions/*/*.js
!output/compositions/*/*.md
!output/compositions/*/.gitkeep
output/compositions/*/renders/
output/compositions/*/node_modules/
output/compositions/*/package-lock.json

# Edit metadata: permitir EDLs y transcripts limpios (no los crudos pesados)
!output/edit/
output/edit/*
!output/edit/edl.json
!output/edit/transcripts/
output/edit/transcripts/*
!output/edit/transcripts/.gitkeep

# Permitir el paquete deploy (incluye los mp4 finales, ~17MB)
!deploy/
!deploy/**

# Skills clonadas (se reinstalan via setup.sh)
skills/video-use/
skills/hyperframes/

# Node / Python
node_modules/
__pycache__/
*.pyc
.python-version

# macOS / Windows
.DS_Store
Thumbs.db
desktop.ini

# Proyectos de clientes (privados — sin assets pesados)
projects/*/assets/
projects/*/*.mp4

# Análisis temporal (frames de inspección)
output/analysis/
